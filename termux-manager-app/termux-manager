show_root_info() {
    separator
    echo -e "${BLUE}Información sobre Acceso Root en Termux${NC}"
    separator
    echo ""
    echo -e "${YELLOW}Métodos para obtener root sin aplicaciones externas:${NC}"
    echo ""
    echo -e "${GREEN}1. Magisk + SuperUser${NC}"
    echo "   - Descarga Magisk Manager desde GitHub"
    echo "   - Flashea el ZIP a través de recovery"
    echo "   - Otorga permisos al instalar Magisk"
    echo ""
    echo -e "${GREEN}2. PhoenixOS o ROM customizada${NC}"
    echo "   - Usa una ROM que incluya acceso root"
    echo "   - KernelSU también proporciona acceso root sin Magisk"
    echo ""
    echo -e "${GREEN}3. Usando su (si el dispositivo lo permite)${NC}"
    echo "   - En algunos dispositivos desbloqueados:"
    echo "   - $ su -"
    echo ""
    echo -e "${YELLOW}Verificar acceso actual a root:${NC}"
    if id | grep -q "root"; then
        log_success "¡Tienes acceso root!"
    else
        log_warning "No tienes acceso root actualmente"
        echo ""
        echo "ID actual: $(id)"
    fi
    echo ""

    echo -e "${YELLOW}Herramientas útiles para escalada de privilegios:${NC}"
    echo ""
    echo -e "${GREEN}1. proot${NC}"
    echo "   - Simula root sin necesidad de permisos reales"
    echo "   - $ apt install proot"
    echo ""
    echo -e "${GREEN}2. fakeroot${NC}"
    echo "   - Fake root para compilaciones"
    echo "   - $ apt install fakeroot"
    echo ""

    read -p "¿Instalar proot y fakeroot? (s/n) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Ss]$ ]]; then
        log_info "Instalando proot y fakeroot..."
        apt install -y proot fakeroot
        log_success "Instalación completada"
    fi
}

root_menu() {
    while true; do
        separator
        echo -e "${BLUE}Menú de Acceso Root${NC}"
        separator
        echo ""
        echo -e "${GREEN}1${NC}. Ver información sobre acceso root"
        echo -e "${GREEN}2${NC}. Instalar SuperUser"
        echo -e "${GREEN}3${NC}. Verificar permisos actuales"
        echo -e "${GREEN}4${NC}. Instalar herramientas de escalada"
        echo -e "${GREEN}0${NC}. Volver"
        echo ""

        read -p "Selecciona una opción: " choice

        case "$choice" in
            1)
                show_root_info
                read -p "Presiona Enter para continuar..."
                ;;
            2)
                log_info "Instalando SuperUser..."
                apt install -y superuser
                log_success "SuperUser instalado"
                read -p "Presiona Enter para continuar..."
                ;;
            3)
                echo ""
                log_info "Permisos actuales:"
                id
                echo ""
                whoami
                echo ""
                read -p "Presiona Enter para continuar..."
                ;;
            4)
                log_info "Instalando herramientas de escalada..."
                apt install -y proot fakeroot
                log_success "Herramientas instaladas"
                read -p "Presiona Enter para continuar..."
                ;;
            0)
                break
                ;;
            *)
                log_error "Opción no válida"
                ;;
        esac
    done
}

