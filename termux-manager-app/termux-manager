    separator
    echo ""

    log_info "Actualizando repositorios..."
    apt update -y

    log_info "Actualizando paquetes..."
    apt upgrade -y

    log_info "Limpiando caché..."
    apt clean
    apt autoclean -y

    log_info "Removiendo paquetes no utilizados..."
    apt autoremove -y

    log_success "Optimización completada"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# ============================================================================
# 6. RESTAURAR CONFIGURACIÓN
# ============================================================================

restore_config() {
    separator
    echo -e "${YELLOW}Restaurar Configuración por Defecto${NC}"
    separator
    echo ""
    echo -e "${RED}⚠ Advertencia:${NC} Esto eliminará configuraciones personalizadas"
    echo ""

    read -p "¿Continuar? (s/n) " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Ss]$ ]]; then
        log_info "Operación cancelada"
        return
    fi

    log_info "Restaurando archivos de configuración..."

    # Restaurar archivos de configuración
    if [[ -f ~/.bashrc ]]; then
        cp ~/.bashrc ~/.bashrc.bak
    fi

    # Crear nuevo .bashrc básico
    cat > ~/.bashrc << 'EOF'
# ~/.bashrc

# Alias útiles
alias ls='ls --color=auto'
alias la='ls -la'
alias ll='ls -l'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Configuración de la terminal
export TERM=xterm-256color
export LANG=es_ES.UTF-8

# Configuración de Git
git config --global user.name "Termux User"
git config --global user.email "user@termux.com"
EOF

    log_success "Configuración restaurada"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# ============================================================================
# FUNCIÓN PRINCIPAL
# ============================================================================

main() {
    if ! is_termux; then
        log_error "Este script solo funciona en Termux"
        exit 1
    fi

    # Si se pasa un argumento, ejecutar ese comando directamente
    if [[ $# -gt 0 ]]; then
        case "$1" in
            install-basic)
                install_basic_tools
                ;;
            install-community)
                community_tools_menu
                ;;
            root-info)
                show_root_info
                ;;
            system-info)
                show_system_info
                ;;
            optimize)
                optimize_termux
                ;;
            restore)
                restore_config
                ;;
            *)
                log_error "Comando desconocido: $1"
                echo "Comandos disponibles:"
                echo "  install-basic      - Instalar herramientas básicas"
                echo "  install-community  - Instalar herramientas de la comunidad"
                echo "  root-info          - Ver información sobre acceso root"
                echo "  system-info        - Ver información del sistema"
                echo "  optimize           - Optimizar Termux"
                echo "  restore            - Restaurar configuración por defecto"
                exit 1
                ;;
        esac
        exit 0
    fi

    # Menú interactivo
    while true; do
        clear
        show_main_menu
        read -p "Selecciona una opción: " choice

        case "$choice" in
            1)
                clear
                install_basic_tools
                read -p "Presiona Enter para continuar..."
                ;;
            2)
                clear
                community_tools_menu
                ;;
            3)
                clear
                root_menu
                ;;
            4)
                clear
                show_system_info
                ;;
            5)
                clear
                optimize_termux
                ;;
            6)
                clear
                restore_config
                ;;
            0)
                log_success "¡Hasta luego!"
                exit 0
                ;;
            *)
                log_error "Opción no válida"
                read -p "Presiona Enter para continuar..."
                ;;
        esac
    done
}

# Ejecutar la función principal
main "$@"
