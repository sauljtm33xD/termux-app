install_tool() {
    local tool="$1"

    if ! check_internet; then
        return 1
    fi

    case "$tool" in
        nmap) apt install -y nmap ;;
        netcat) apt install -y netcat-traditional ;;
        tcpdump) apt install -y tcpdump ;;
        openssh) apt install -y openssh ;;
        curl) apt install -y curl ;;
        wget) apt install -y wget ;;
        whois) apt install -y whois ;;
        dig) apt install -y dnsutils ;;
        telnet) apt install -y telnet ;;
        socat) apt install -y socat ;;
        hashcat) apt install -y hashcat ;;
        hydra) apt install -y hydra ;;
        john) apt install -y john ;;
        sqlmap) apt install -y sqlmap ;;
        metasploit) log_warning "Requiere mucho espacio..." && apt install -y metasploit ;;
        nikto) apt install -y nikto ;;
        ettercap) apt install -y ettercap ;;
        kismet) apt install -y kismet ;;
        openssl) apt install -y openssl ;;
        gpg) apt install -y gnupg ;;
        tor) apt install -y tor ;;
        golang) apt install -y golang ;;
        rust) apt install -y rust ;;
        python) apt install -y python ;;
        php) apt install -y php ;;
        nodejs) apt install -y nodejs ;;
        ruby) apt install -y ruby ;;
        lua) apt install -y lua ;;
        perl) apt install -y perl ;;
        git) apt install -y git ;;
        make) apt install -y make ;;
        cmake) apt install -y cmake ;;
        ffmpeg) apt install -y ffmpeg ;;
        imagemagick) apt install -y imagemagick ;;
        sox) apt install -y sox ;;
        postgresql) apt install -y postgresql ;;
        mariadb) apt install -y mariadb ;;
        sqlite) apt install -y sqlite ;;
        redis) apt install -y redis ;;
        mongodb) apt install -y mongodb ;;
        tmux) apt install -y tmux ;;
        htop) apt install -y htop ;;
        iotop) apt install -y iotop ;;
        ncdu) apt install -y ncdu ;;
        tree) apt install -y tree ;;
        fzf) apt install -y fzf ;;
        ripgrep) apt install -y ripgrep ;;
        nginx) apt install -y nginx ;;
        apache) apt install -y apache2 ;;
        adb) apt install -y android-tools ;;
        frida) pip install frida-tools ;;
        *) log_error "Herramienta no válida"; return 1 ;;
    esac

    if [[ $? -eq 0 ]]; then
        log_success "¡$tool instalado!"
    else
        log_error "Falló la instalación"
        return 1
    fi
}

