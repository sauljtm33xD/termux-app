#!/bin/bash

# Termux Manager - Herramienta para instalar herramientas de la comunidad y obtener root
# Funciona sin root en Termux
# Uso: ./termux-manager [comando]

set -e

# Colores para la salida
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # Sin color

# Configuración
TERMUX_PREFIX="${PREFIX:-$HOME/../usr}"
TERMUX_CACHE="${HOME}/.termux-manager"

# Crear directorio de caché si no existe
mkdir -p "$TERMUX_CACHE"

# ============================================================================
# FUNCIONES DE UTILIDAD
# ============================================================================

log_info() {
    echo -e "${CYAN}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[⚠]${NC} $1"
}

separator() {
    echo -e "${PURPLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

is_termux() {
    [[ -d "$TERMUX_PREFIX" ]] || return 1
}

check_internet() {
    if ! ping -c 1 8.8.8.8 &>/dev/null; then
        log_error "No hay conexión a internet"
        return 1
    fi
    return 0
}

