# ============================================================================
# 1. INSTALAR HERRAMIENTAS BÁSICAS
# ============================================================================

install_basic_tools() {
    log_info "Instalando herramientas básicas..."

    if ! check_internet; then
        return 1
    fi

    local tools=(
        "curl"
        "wget"
        "git"
        "nano"
        "vim"
        "openssh"
        "openssl"
        "python"
        "nodejs"
        "build-essential"
    )

    echo ""
    log_info "Actualizando lista de paquetes..."
    apt update -y

    for tool in "${tools[@]}"; do
        if ! command -v "$tool" &>/dev/null; then
            log_info "Instalando: $tool"
            apt install -y "$tool" 2>/dev/null || log_warning "No se pudo instalar $tool"
        else
            log_success "$tool ya está instalado"
        fi
    done

    log_success "Herramientas básicas instaladas"
}

