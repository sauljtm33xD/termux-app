show_system_info() {
    separator
    echo -e "${BLUE}Información del Sistema${NC}"
    separator
    echo ""

    echo -e "${GREEN}Sistema Operativo:${NC}"
    if is_termux; then
        log_success "Ejecutándose en Termux"
    else
        log_error "No se detectó Termux"
    fi
    echo ""

    echo -e "${GREEN}Android Version:${NC}"
    getprop ro.build.version.release 2>/dev/null || echo "Desconocida"
    echo ""

    echo -e "${GREEN}Arquitectura del Dispositivo:${NC}"
    uname -m
    echo ""

    echo -e "${GREEN}Termux Prefix:${NC}"
    echo "$TERMUX_PREFIX"
    echo ""

    echo -e "${GREEN}Espacio Libre:${NC}"
    df -h "$TERMUX_PREFIX" | tail -1
    echo ""

    echo -e "${GREEN}Versión de Bash:${NC}"
    bash --version | head -1
    echo ""

    echo -e "${GREEN}Paquetes Instalados:${NC}"
    apt list --installed 2>/dev/null | wc -l
    echo ""

    echo -e "${GREEN}Memoria Disponible:${NC}"
    free -h 2>/dev/null || echo "No disponible"
    echo ""

    read -p "Presiona Enter para continuar..."
}

