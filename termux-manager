#!/bin/bash

# Termux Manager - Herramienta para instalar herramientas de la comunidad y obtener root
# Funciona sin root en Termux
# Uso: ./termux-manager [comando]

set -e

# Colores para la salida
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # Sin color

# Configuración
TERMUX_PREFIX="${PREFIX:-$HOME/../usr}"
TERMUX_CACHE="${HOME}/.termux-manager"

# Crear directorio de caché si no existe
mkdir -p "$TERMUX_CACHE"

# ============================================================================
# FUNCIONES DE UTILIDAD
# ============================================================================

log_info() {
    echo -e "${CYAN}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[⚠]${NC} $1"
}

separator() {
    echo -e "${PURPLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

is_termux() {
    [[ -d "$TERMUX_PREFIX" ]] || return 1
}

check_internet() {
    if ! ping -c 1 8.8.8.8 &>/dev/null; then
        log_error "No hay conexión a internet"
        return 1
    fi
    return 0
}

# ============================================================================
# MENÚ PRINCIPAL
# ============================================================================

show_main_menu() {
    separator
    echo -e "${BLUE}╔════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}      ${CYAN}Termux Manager - Gestor de Herramientas${NC}        ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════╝${NC}"
    separator
    echo ""
    echo -e "${GREEN}1${NC}. Instalar herramientas básicas"
    echo -e "${GREEN}2${NC}. Instalar herramientas de la comunidad"
    echo -e "${GREEN}3${NC}. Configurar acceso root"
    echo -e "${GREEN}4${NC}. Ver información del sistema"
    echo -e "${GREEN}5${NC}. Optimizar Termux"
    echo -e "${GREEN}6${NC}. Restaurar configuración por defecto"
    echo -e "${GREEN}0${NC}. Salir"
    echo ""
}

# ============================================================================
# 1. INSTALAR HERRAMIENTAS BÁSICAS
# ============================================================================

install_basic_tools() {
    log_info "Instalando herramientas básicas..."

    if ! check_internet; then
        return 1
    fi

    local tools=(
        "curl"
        "wget"
        "git"
        "nano"
        "vim"
        "openssh"
        "openssl"
        "python"
        "nodejs"
        "build-essential"
    )

    echo ""
    log_info "Actualizando lista de paquetes..."
    apt update -y

    for tool in "${tools[@]}"; do
        if ! command -v "$tool" &>/dev/null; then
            log_info "Instalando: $tool"
            apt install -y "$tool" 2>/dev/null || log_warning "No se pudo instalar $tool"
        else
            log_success "$tool ya está instalado"
        fi
    done

    log_success "Herramientas básicas instaladas"
}

# ============================================================================
# 2. INSTALAR HERRAMIENTAS DE LA COMUNIDAD
# ============================================================================

show_community_tools_menu() {
    separator
    echo -e "${BLUE}Herramientas de la Comunidad para Termux${NC}"
    separator
    echo ""
    echo -e "${GREEN}Utilidades de Red:${NC}"
    echo "  1. nmap        - Escaneo de puertos y redes"
    echo "  2. netcat      - Utilidad de red versátil"
    echo "  3. tcpdump     - Captura de paquetes de red"
    echo ""
    echo -e "${GREEN}Herramientas de Seguridad:${NC}"
    echo "  4. hashcat     - Cracking de contraseñas"
    echo "  5. hydra       - Herramienta de ataque por fuerza bruta"
    echo "  6. metasploit  - Framework de penetración"
    echo ""
    echo -e "${GREEN}Desarrollo:${NC}"
    echo "  7. golang      - Lenguaje Go"
    echo "  8. rust        - Lenguaje Rust"
    echo "  9. php         - Intérprete PHP"
    echo ""
    echo -e "${GREEN}Utilidades:${NC}"
    echo "  10. tmux       - Multiplexor de terminal"
    echo "  11. htop       - Monitor de procesos mejorado"
    echo "  12. ffmpeg     - Procesador multimedia"
    echo ""
    echo -e "${GREEN}Base de Datos:${NC}"
    echo "  13. postgresql - Base de datos PostgreSQL"
    echo "  14. mariadb    - Base de datos MariaDB"
    echo "  15. redis      - Cache en memoria"
    echo ""
    echo -e "${GREEN}99. Instalar todo${NC}"
    echo -e "${GREEN}0. Volver${NC}"
    echo ""
}

install_community_tool() {
    local tool="$1"

    if ! check_internet; then
        return 1
    fi

    case "$tool" in
        1|nmap)
            log_info "Instalando nmap..."
            apt install -y nmap
            ;;
        2|netcat)
            log_info "Instalando netcat..."
            apt install -y netcat-traditional
            ;;
        3|tcpdump)
            log_info "Instalando tcpdump..."
            apt install -y tcpdump
            ;;
        4|hashcat)
            log_info "Instalando hashcat..."
            apt install -y hashcat
            ;;
        5|hydra)
            log_info "Instalando hydra..."
            apt install -y hydra
            ;;
        6|metasploit)
            log_warning "Metasploit requiere espacio adicional. Instalando..."
            apt install -y metasploit
            ;;
        7|golang)
            log_info "Instalando Go..."
            apt install -y golang
            ;;
        8|rust)
            log_info "Instalando Rust..."
            apt install -y rust
            ;;
        9|php)
            log_info "Instalando PHP..."
            apt install -y php
            ;;
        10|tmux)
            log_info "Instalando tmux..."
            apt install -y tmux
            ;;
        11|htop)
            log_info "Instalando htop..."
            apt install -y htop
            ;;
        12|ffmpeg)
            log_info "Instalando ffmpeg..."
            apt install -y ffmpeg
            ;;
        13|postgresql)
            log_info "Instalando PostgreSQL..."
            apt install -y postgresql
            ;;
        14|mariadb)
            log_info "Instalando MariaDB..."
            apt install -y mariadb
            ;;
        15|redis)
            log_info "Instalando Redis..."
            apt install -y redis
            ;;
        99)
            log_info "Instalando todos los paquetes (esto puede tardar)..."
            local all_tools="nmap netcat-traditional tcpdump hashcat hydra golang rust php tmux htop ffmpeg redis"
            apt install -y $all_tools
            ;;
        *)
            log_error "Opción no válida"
            return 1
            ;;
    esac

    if [[ $? -eq 0 ]]; then
        log_success "Instalación completada"
    else
        log_error "La instalación falló"
        return 1
    fi
}

community_tools_menu() {
    while true; do
        show_community_tools_menu
        read -p "Selecciona una opción: " choice

        if [[ "$choice" == "0" ]]; then
            break
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le 99 ]]; then
            install_community_tool "$choice"
            echo ""
            read -p "Presiona Enter para continuar..."
        else
            log_error "Opción no válida"
            read -p "Presiona Enter para continuar..."
        fi
    done
}

# ============================================================================
# 3. CONFIGURAR ACCESO ROOT
# ============================================================================

show_root_info() {
    separator
    echo -e "${BLUE}Información sobre Acceso Root en Termux${NC}"
    separator
    echo ""
    echo -e "${YELLOW}Métodos para obtener root sin aplicaciones externas:${NC}"
    echo ""
    echo -e "${GREEN}1. Magisk + SuperUser${NC}"
    echo "   - Descarga Magisk Manager desde GitHub"
    echo "   - Flashea el ZIP a través de recovery"
    echo "   - Otorga permisos al instalar Magisk"
    echo ""
    echo -e "${GREEN}2. PhoenixOS o ROM customizada${NC}"
    echo "   - Usa una ROM que incluya acceso root"
    echo "   - KernelSU también proporciona acceso root sin Magisk"
    echo ""
    echo -e "${GREEN}3. Usando su (si el dispositivo lo permite)${NC}"
    echo "   - En algunos dispositivos desbloqueados:"
    echo "   - $ su -"
    echo ""
    echo -e "${YELLOW}Verificar acceso actual a root:${NC}"
    if id | grep -q "root"; then
        log_success "¡Tienes acceso root!"
    else
        log_warning "No tienes acceso root actualmente"
        echo ""
        echo "ID actual: $(id)"
    fi
    echo ""

    echo -e "${YELLOW}Herramientas útiles para escalada de privilegios:${NC}"
    echo ""
    echo -e "${GREEN}1. proot${NC}"
    echo "   - Simula root sin necesidad de permisos reales"
    echo "   - $ apt install proot"
    echo ""
    echo -e "${GREEN}2. fakeroot${NC}"
    echo "   - Fake root para compilaciones"
    echo "   - $ apt install fakeroot"
    echo ""

    read -p "¿Instalar proot y fakeroot? (s/n) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Ss]$ ]]; then
        log_info "Instalando proot y fakeroot..."
        apt install -y proot fakeroot
        log_success "Instalación completada"
    fi
}

root_menu() {
    while true; do
        separator
        echo -e "${BLUE}Menú de Acceso Root${NC}"
        separator
        echo ""
        echo -e "${GREEN}1${NC}. Ver información sobre acceso root"
        echo -e "${GREEN}2${NC}. Instalar SuperUser"
        echo -e "${GREEN}3${NC}. Verificar permisos actuales"
        echo -e "${GREEN}4${NC}. Instalar herramientas de escalada"
        echo -e "${GREEN}0${NC}. Volver"
        echo ""

        read -p "Selecciona una opción: " choice

        case "$choice" in
            1)
                show_root_info
                read -p "Presiona Enter para continuar..."
                ;;
            2)
                log_info "Instalando SuperUser..."
                apt install -y superuser
                log_success "SuperUser instalado"
                read -p "Presiona Enter para continuar..."
                ;;
            3)
                echo ""
                log_info "Permisos actuales:"
                id
                echo ""
                whoami
                echo ""
                read -p "Presiona Enter para continuar..."
                ;;
            4)
                log_info "Instalando herramientas de escalada..."
                apt install -y proot fakeroot
                log_success "Herramientas instaladas"
                read -p "Presiona Enter para continuar..."
                ;;
            0)
                break
                ;;
            *)
                log_error "Opción no válida"
                ;;
        esac
    done
}

# ============================================================================
# 4. INFORMACIÓN DEL SISTEMA
# ============================================================================

show_system_info() {
    separator
    echo -e "${BLUE}Información del Sistema${NC}"
    separator
    echo ""

    echo -e "${GREEN}Sistema Operativo:${NC}"
    if is_termux; then
        log_success "Ejecutándose en Termux"
    else
        log_error "No se detectó Termux"
    fi
    echo ""

    echo -e "${GREEN}Android Version:${NC}"
    getprop ro.build.version.release 2>/dev/null || echo "Desconocida"
    echo ""

    echo -e "${GREEN}Arquitectura del Dispositivo:${NC}"
    uname -m
    echo ""

    echo -e "${GREEN}Termux Prefix:${NC}"
    echo "$TERMUX_PREFIX"
    echo ""

    echo -e "${GREEN}Espacio Libre:${NC}"
    df -h "$TERMUX_PREFIX" | tail -1
    echo ""

    echo -e "${GREEN}Versión de Bash:${NC}"
    bash --version | head -1
    echo ""

    echo -e "${GREEN}Paquetes Instalados:${NC}"
    apt list --installed 2>/dev/null | wc -l
    echo ""

    echo -e "${GREEN}Memoria Disponible:${NC}"
    free -h 2>/dev/null || echo "No disponible"
    echo ""

    read -p "Presiona Enter para continuar..."
}

# ============================================================================
# 5. OPTIMIZAR TERMUX
# ============================================================================

optimize_termux() {
    separator
    echo -e "${BLUE}Optimizando Termux${NC}"
    separator
    echo ""

    log_info "Actualizando repositorios..."
    apt update -y

    log_info "Actualizando paquetes..."
    apt upgrade -y

    log_info "Limpiando caché..."
    apt clean
    apt autoclean -y

    log_info "Removiendo paquetes no utilizados..."
    apt autoremove -y

    log_success "Optimización completada"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# ============================================================================
# 6. RESTAURAR CONFIGURACIÓN
# ============================================================================

restore_config() {
    separator
    echo -e "${YELLOW}Restaurar Configuración por Defecto${NC}"
    separator
    echo ""
    echo -e "${RED}⚠ Advertencia:${NC} Esto eliminará configuraciones personalizadas"
    echo ""

    read -p "¿Continuar? (s/n) " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Ss]$ ]]; then
        log_info "Operación cancelada"
        return
    fi

    log_info "Restaurando archivos de configuración..."

    # Restaurar archivos de configuración
    if [[ -f ~/.bashrc ]]; then
        cp ~/.bashrc ~/.bashrc.bak
    fi

    # Crear nuevo .bashrc básico
    cat > ~/.bashrc << 'EOF'
# ~/.bashrc

# Alias útiles
alias ls='ls --color=auto'
alias la='ls -la'
alias ll='ls -l'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Configuración de la terminal
export TERM=xterm-256color
export LANG=es_ES.UTF-8

# Configuración de Git
git config --global user.name "Termux User"
git config --global user.email "user@termux.com"
EOF

    log_success "Configuración restaurada"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# ============================================================================
# FUNCIÓN PRINCIPAL
# ============================================================================

main() {
    if ! is_termux; then
        log_error "Este script solo funciona en Termux"
        exit 1
    fi

    # Si se pasa un argumento, ejecutar ese comando directamente
    if [[ $# -gt 0 ]]; then
        case "$1" in
            install-basic)
                install_basic_tools
                ;;
            install-community)
                community_tools_menu
                ;;
            root-info)
                show_root_info
                ;;
            system-info)
                show_system_info
                ;;
            optimize)
                optimize_termux
                ;;
            restore)
                restore_config
                ;;
            *)
                log_error "Comando desconocido: $1"
                echo "Comandos disponibles:"
                echo "  install-basic      - Instalar herramientas básicas"
                echo "  install-community  - Instalar herramientas de la comunidad"
                echo "  root-info          - Ver información sobre acceso root"
                echo "  system-info        - Ver información del sistema"
                echo "  optimize           - Optimizar Termux"
                echo "  restore            - Restaurar configuración por defecto"
                exit 1
                ;;
        esac
        exit 0
    fi

    # Menú interactivo
    while true; do
        clear
        show_main_menu
        read -p "Selecciona una opción: " choice

        case "$choice" in
            1)
                clear
                install_basic_tools
                read -p "Presiona Enter para continuar..."
                ;;
            2)
                clear
                community_tools_menu
                ;;
            3)
                clear
                root_menu
                ;;
            4)
                clear
                show_system_info
                ;;
            5)
                clear
                optimize_termux
                ;;
            6)
                clear
                restore_config
                ;;
            0)
                log_success "¡Hasta luego!"
                exit 0
                ;;
            *)
                log_error "Opción no válida"
                read -p "Presiona Enter para continuar..."
                ;;
        esac
    done
}

# Ejecutar la función principal
main "$@"
